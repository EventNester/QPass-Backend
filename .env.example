NODE_ENV=development
PORT=3000
LOG_LEVEL=info                # debug | info | warn | error

# HTTP
CORS_ORIGIN=http://localhost:3000
SWAGGER_ENABLED=true          # true | false

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=qpass
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/qpass?schema=public"

# Redis 
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DATABASE=0

# JWT Authentication
JWT_SECRET=your_secret_key_min_32_bytes_long_here
JWT_EXPIRES_IN=30m
JWT_REFRESH_SECRET=your_refresh_secret_key_min_32_bytes
JWT_REFRESH_EXPIRES_IN=7d

# Paystack (Test Mode)
PAYSTACK_SECRET_KEY=enter_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=enter_paystack_public_key_here
PAYSTACK_WEBHOOK_SECRET=enter_paystack_webhook_secret_here

# Frontend URL (for password reset link)
FRONTEND_URL=http://localhost:3000

# Google OAuth (Sign in with Google)
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match GOOGLE_CALLBACK_URL exactly.
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# Backend callback URL registered in Google Cloud Console
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
# Where to redirect after successful Google auth (defaults to FRONTEND_URL/pages/dashboard.html)
# Leave blank to use the default. Example: http://localhost:3000/pages/dashboard.html
OAUTH_FRONTEND_REDIRECT_URL=
# Email (Brevo REST API)
# Emails are sent through the Brevo transactional email REST API
# (https://api.brevo.com/v3/smtp/email). This works on free hosting platforms
# (Railway, Vercel, etc.) where SMTP ports are blocked.
# Generate an API key at Brevo > Settings > API Keys.
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_sender_email_here
BREVO_SENDER_NAME=your_sender_name_here

# Sentry Error Tracking (Optional)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Socket.IO
SOCKET_CORS_ORIGIN=http://localhost:3000

# File Uploads
UPLOAD_DIR=uploads                     # Directory for uploaded files (default: uploads)
