NODE_ENV=development
PORT=3000
LOG_LEVEL=info                # debug | info | warn | error

# HTTP
CORS_ORIGIN=*
SWAGGER_ENABLED=true          # true | false

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=qpass
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/qpass?schema=public"

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DATABASE=0

# ── JWT Authentication ────────────────────────────────────────────────────────
JWT_SECRET=your_secret_key_min_32_bytes_long_here
JWT_EXPIRES_IN=30m
JWT_REFRESH_SECRET=your_refresh_secret_key_min_32_bytes
JWT_REFRESH_EXPIRES_IN=7d

# ── Paystack (Test Mode) ──────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=enter_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=enter_paystack_public_key_here
PAYSTACK_WEBHOOK_SECRET=enter_paystack_webhook_secret_here

# ── Brevo Email Service ───────────────────────────────────────────────────────
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@qpass.com
BREVO_SENDER_NAME=QPass
BREVO_TEMPLATE_WELCOME=1
BREVO_TEMPLATE_QR_GENERATED=2
BREVO_TEMPLATE_CHECKIN_CONFIRMATION=3
BREVO_TEMPLATE_EVENT_REMINDER=4
BREVO_TEMPLATE_PAYMENT_CONFIRMATION=5

# ── Sentry Error Tracking (Optional) ──────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Socket.IO ─────────────────────────────────────────────────────────────────
SOCKET_CORS_ORIGIN=*
