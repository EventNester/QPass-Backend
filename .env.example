NODE_ENV=development
PORT=3000
LOG_LEVEL=info                # debug | info | warn | error

# HTTP
CORS_ORIGIN=*
SWAGGER_ENABLED=true          # true | false

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=qpass
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/qpass?schema=public"

# Redis 
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DATABASE=0

# JWT Authentication
JWT_SECRET=your_secret_key_min_32_bytes_long_here
JWT_EXPIRES_IN=30m
JWT_REFRESH_SECRET=your_refresh_secret_key_min_32_bytes
JWT_REFRESH_EXPIRES_IN=7d

# Paystack (Test Mode)
PAYSTACK_SECRET_KEY=enter_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=enter_paystack_public_key_here
PAYSTACK_WEBHOOK_SECRET=enter_paystack_webhook_secret_here

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=QPass <noreply@qpass.com>

# Sentry Error Tracking (Optional)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Socket.IO
SOCKET_CORS_ORIGIN=*

# File Uploads
UPLOAD_DIR=uploads                     # Directory for uploaded files (default: uploads)
