{
  "openapi": "3.0.0",
  "info": {
    "title": "QPass API",
    "version": "1.0.0",
    "description": "QR Code-Based Event Attendance & Ticket Verification System API.\n\n## Authentication\nMost endpoints require a JWT bearer token. Get one via `/api/v1/auth/login`,\nthen click **Authorize** at the top and paste `Bearer <your-token>`.\n\n## Conventions\n- All responses follow `{ status, message?, data }`\n- Errors use standard HTTP status codes (400, 401, 403, 404, 409, 422, 500)\n- Timestamps are ISO-8601 strings",
    "contact": {
      "name": "QPass Team",
      "email": "support@qpass.com"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Development server"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Service health & readiness"
    },
    {
      "name": "Auth",
      "description": "Registration, login, refresh, logout"
    },
    {
      "name": "Checkins",
      "description": "QR scanning and attendance tracking"
    },
    {
      "name": "Events",
      "description": "Event management (Aspirational)"
    },
    {
      "name": "Tickets",
      "description": "Ticket code management (Aspirational)"
    },
    {
      "name": "Attendees",
      "description": "Attendee verification (Aspirational)"
    }
  ],

  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT access token from /auth/login"
      }
    },
    "schemas": {
      "SuccessResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "success"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": ["name", "email", "password"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "Ada Lovelace"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "ada@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "format": "password"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        }
      },
      "RefreshRequest": {
        "type": "object",
        "required": ["refreshToken"],
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        }
      },
      "LogoutRequest": {
        "type": "object",
        "required": ["refreshToken"],
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        }
      },
      "AuthUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string",
            "enum": ["ATTENDEE", "STAFF", "ORGANIZER", "ADMIN"]
          },
          "status": {
            "type": "string",
            "enum": ["ACTIVE", "INACTIVE", "SUSPENDED"]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AuthTokens": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Short-lived JWT for the Authorization header"
          },
          "refreshToken": {
            "type": "string",
            "description": "Long-lived JWT used to mint new access tokens"
          },
          "expiresIn": {
            "type": "string",
            "example": "30m"
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "success"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "properties": {
              "user": {
                "$ref": "#/components/schemas/AuthUser"
              },
              "tokens": {
                "$ref": "#/components/schemas/AuthTokens"
              }
            }
          }
        }
      },
      "ScanRequest": {
        "type": "object",
        "required": ["token"],
        "properties": {
          "token": {
            "type": "string",
            "description": "Raw QR token (hashed server-side)"
          },
          "deviceInfo": {
            "type": "string"
          }
        }
      },
      "ScanResult": {
        "type": "object",
        "properties": {
          "result": {
            "type": "string",
            "enum": ["VALID", "DUPLICATE", "INVALID"]
          },
          "message": {
            "type": "string"
          },
          "attendeeName": {
            "type": "string"
          },
          "checkinId": {
            "type": "string"
          }
        }
      },
      "Event": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "ownerId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "venue": {
            "type": "string"
          },
          "startTime": {
            "type": "string",
            "format": "date-time"
          },
          "endTime": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": ["DRAFT", "PUBLISHED", "ACTIVE", "COMPLETED", "CANCELLED"]
          },
          "registrationMode": {
            "type": "string",
            "enum": ["PUBLIC_LINK", "CLOSED_IMPORT", "HYBRID"]
          },
          "isPaid": {
            "type": "boolean"
          },
          "capacity": {
            "type": "integer"
          },
          "currency": {
            "type": "string"
          },
          "registrationOpensAt": {
            "type": "string",
            "format": "date-time"
          },
          "registrationClosesAt": {
            "type": "string",
            "format": "date-time"
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "EventResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "success" },
          "message": { "type": "string" },
          "data": { "$ref": "#/components/schemas/Event" }
        }
      },      "EventCreateRequest": {
        "type": "object",
        "required": [
          "title",
          "startTime",
          "endTime",
          "registrationMode"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "slug": {
            "type": "string",
            "readOnly": true
          },
          "description": {
            "type": "string"
          },
          "venue": {
            "type": "string"
          },
          "startTime": {
            "type": "string",
            "format": "date-time"
          },
          "endTime": {
            "type": "string",
            "format": "date-time"
          },
          "registrationMode": {
            "type": "string",
            "enum": ["PUBLIC_LINK", "CLOSED_IMPORT", "HYBRID"]
          },
          "isPaid": {
            "type": "boolean"
          },
          "capacity": {
            "type": "integer"
          },
          "currency": {
            "type": "string"
          },
          "registrationOpensAt": {
            "type": "string",
            "format": "date-time"
          },
          "registrationClosesAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "EventUpdateRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "slug": {
            "type": "string",
            "readOnly": true
          },
          "description": {
            "type": "string"
          },
          "venue": {
            "type": "string"
          },
          "startTime": {
            "type": "string",
            "format": "date-time"
          },
          "endTime": {
            "type": "string",
            "format": "date-time"
          },
          "registrationMode": {
            "type": "string",
            "enum": ["PUBLIC_LINK", "CLOSED_IMPORT", "HYBRID"]
          },
          "isPaid": {
            "type": "boolean"
          },
          "capacity": {
            "type": "integer"
          },
          "currency": {
            "type": "string"
          },
          "registrationOpensAt": {
            "type": "string",
            "format": "date-time"
          },
          "registrationClosesAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TicketType": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "eventId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "integer",
            "description": "Amount in smallest currency unit (e.g., kobo for NGN)"
          },
          "capacity": {
            "type": "integer"
          },
          "quantitySold": {
            "type": "integer",
            "default": 0
          },
          "active": {
            "type": "boolean",
            "default": true
          },
          "sortOrder": {
            "type": "integer",
            "default": 0
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TicketTypeCreateRequest": {
        "type": "object",
        "required": ["name", "price", "capacity"],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "integer",
            "description": "Amount in smallest currency unit (e.g., kobo for NGN)"
          },
          "capacity": {
            "type": "integer"
          }
        }
      },
      "TicketTypeUpdateRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "integer",
            "description": "Amount in smallest currency unit (e.g., kobo for NGN)"
          },
          "capacity": {
            "type": "integer"
          }
        }
      },
      "Registration": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "eventId": {
            "type": "string"
          },
          "ticketCodeId": {
            "type": "string"
          },
          "attendeeEmail": {
            "type": "string"
          },
          "attendeeName": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "ticketTypeId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["PENDING", "CONFIRMED", "CANCELLED"]
          },
          "paymentStatus": {
            "type": "string",
            "enum": ["PENDING", "SUCCESS", "FAILED", "REFUNDED"]
          },
          "source": {
            "type": "string",
            "enum": ["IMPORT", "PUBLIC_LINK"]
          },
          "confirmationCode": {
            "type": "string"
          },
          "metadata": {
            "type": "object"
          },
          "qrIssued": {
            "type": "boolean"
          },
          "qrIssuedAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RegistrationCreateRequest": {
        "type": "object",
        "required": ["attendeeName", "attendeeEmail"],
        "properties": {
          "attendeeName": {
            "type": "string"
          },
          "attendeeEmail": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "ticketTypeId": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": ["IMPORT", "PUBLIC_LINK"]
          },
          "metadata": {
            "type": "object"
          }
        }
      },
      "ForgotPasswordRequest": {
        "type": "object",
        "required": ["email"],
        "properties": {
          "email": { "type": "string", "format": "email" }
        }
      },
      "ResetPasswordRequest": {
        "type": "object",
        "required": ["token", "newPassword"],
        "properties": {
          "token": { "type": "string" },
          "newPassword": { "type": "string", "format": "password" }
        }
      },
      "TicketCode": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "eventId": { "type": "string" },
          "code": { "type": "string" },
          "status": { "type": "string", "enum": ["UNUSED", "USED", "REVOKED"] },
          "usedAt": { "type": "string", "format": "date-time" },
          "attendeeEmail": { "type": "string" },
          "attendeeName": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "ImportBatch": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "eventId": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["PENDING", "PROCESSING", "COMPLETED", "FAILED"]
          },
          "totalRows": { "type": "integer" },
          "successRows": { "type": "integer" },
          "failedRows": { "type": "integer" },
          "uploadedById": { "type": "string" },
          "originalFilename": { "type": "string" },
          "fileType": { "type": "string", "enum": ["csv", "xlsx", "pdf", "docx"] },
          "errorReport": { "type": "object" },
          "completedAt": { "type": "string", "format": "date-time" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "Payment": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "eventId": { "type": "string" },
          "userId": { "type": "string" },
          "registrationId": { "type": "string" },
          "paystackReference": { "type": "string" },
          "amount": {
            "type": "integer",
            "description": "Amount in smallest currency unit (e.g., kobo for NGN)"
          },
          "currency": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["PENDING", "SUCCESS", "FAILED", "REFUNDED"]
          },
          "gateway": { "type": "string" },
          "metadata": { "type": "object" },
          "verifiedAt": { "type": "string", "format": "date-time" },
          "createdAt": { "type": "string", "format": "date-time" },
          "paidAt": { "type": "string", "format": "date-time" }
        }
      },
      "QrToken": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "registrationId": { "type": "string" },
          "tokenHash": { "type": "string" },
          "issuedAt": { "type": "string", "format": "date-time" },
          "expiresAt": { "type": "string", "format": "date-time" },
          "revokedAt": { "type": "string", "format": "date-time" },
          "scanCount": { "type": "integer" }
        }
      },
      "Invoice": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "eventId": { "type": "string" },
          "paymentId": { "type": "string" },
          "invoiceNumber": { "type": "string" },
          "amount": { "type": "integer" },
          "issueDate": { "type": "string", "format": "date-time" },
          "dueDate": { "type": "string", "format": "date-time" },
          "status": { "type": "string", "enum": ["PENDING", "PAID", "OVERDUE", "CANCELLED"] }
        }
      },
      "Notification": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "recipient": { "type": "string" },
          "channel": { "type": "string" },
          "template": { "type": "string" },
          "status": { "type": "string", "enum": ["PENDING", "SENT", "FAILED", "READ"] },
          "userId": { "type": "string" },
          "eventId": { "type": "string" },
          "registrationId": { "type": "string" },
          "providerMessageId": { "type": "string" },
          "failureReason": { "type": "string" },
          "sentAt": { "type": "string", "format": "date-time" },
          "readAt": { "type": "string", "format": "date-time" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "AuditLog": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "actorId": { "type": "string" },
          "action": { "type": "string" },
          "entity": { "type": "string" },
          "entityId": { "type": "string" },
          "beforeSnapshot": { "type": "object" },
          "afterSnapshot": { "type": "object" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "EventStaffAssignment": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "eventId": { "type": "string" },
          "userId": { "type": "string" },
          "permissionScope": { "type": "string" },
          "active": { "type": "boolean" },
          "assignedAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
