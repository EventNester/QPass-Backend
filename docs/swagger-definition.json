{
  "openapi": "3.0.0",
  "info": {
    "title": "QPass API",
    "version": "1.0.0",
    "description": "QR Code-Based Event Attendance & Ticket Verification System API.\n\n## Authentication\nMost endpoints require a JWT bearer token. Get one via `/api/v1/auth/login`,\nthen click **Authorize** at the top and paste `Bearer <your-token>`.\n\n## Conventions\n- All responses follow `{ status, message?, data }`\n- Errors use standard HTTP status codes (400, 401, 403, 404, 409, 422, 500)\n- Timestamps are ISO-8601 strings",
    "contact": {
      "name": "QPass Team",
      "email": "support@qpass.com"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Development server"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Service health & readiness"
    },
    {
      "name": "Auth",
      "description": "Registration, login, refresh, logout"
    },
    {
      "name": "Checkins",
      "description": "QR scanning and attendance tracking"
    },
    {
      "name": "Events",
      "description": "Event management (Aspirational)"
    },
    {
      "name": "Tickets",
      "description": "Ticket code management (Aspirational)"
    },
    {
      "name": "Attendees",
      "description": "Attendee verification (Aspirational)"
    }
  ],
  "paths": {
    "/api/v1/events": {
      "get": {
        "summary": "List all events",
        "description": "Retrieves a list of all events (Not Yet Implemented).",
        "tags": [
          "Events"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "summary": "Create a new event",
        "description": "Creates a new event (Requires ORGANIZER or ADMIN role) (Not Yet Implemented).",
        "tags": [
          "Events"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Created"
          }
        }
      }
    },
    "/api/v1/events/{eventId}": {
      "get": {
        "summary": "Get details of a specific event",
        "description": "Not Yet Implemented",
        "tags": [
          "Events"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "eventId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not Found"
          }
        }
      },
      "patch": {
        "summary": "Update event details",
        "description": "Not Yet Implemented",
        "tags": [
          "Events"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "eventId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not Found"
          }
        }
      },
      "delete": {
        "summary": "Delete/cancel an event",
        "description": "Not Yet Implemented",
        "tags": [
          "Events"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "eventId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/v1/events/{eventId}/tickets/upload": {
      "post": {
        "summary": "Upload ticket codes via CSV parsing",
        "description": "Not Yet Implemented",
        "tags": [
          "Tickets"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "eventId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/events/{eventId}/tickets": {
      "get": {
        "summary": "List ticket codes and track statuses",
        "description": "Not Yet Implemented",
        "tags": [
          "Tickets"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "eventId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/events/{eventId}/tickets/validate": {
      "post": {
        "summary": "Validate a specific ticket code status",
        "description": "Not Yet Implemented",
        "tags": [
          "Tickets"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "eventId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
