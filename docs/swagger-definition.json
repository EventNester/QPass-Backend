    "/api/v1/events/{eventId}/attendees/verify": {
      "post": {
        "summary": "Verify an attendee using their ticket code",
        "description": "Not Yet Implemented",
        "tags": [
          "Attendees"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "eventId",
            "required": true,
            "schema": {
              "type": "string"
            }
