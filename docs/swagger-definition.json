      }
    },
    "/api/v1/events/{eventId}/attendees/qr-token": {
      "post": {
        "summary": "Generate signed JWT QR token for the attendee",
        "description": "Not Yet Implemented",
        "tags": [
          "Attendees"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "eventId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
