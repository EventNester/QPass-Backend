generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum UserRole {
  ATTENDEE
  STAFF
  ORGANIZER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TicketCodeStatus {
  UNUSED
  USED
  REVOKED
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum CheckInResult {
  VALID
  DUPLICATE
  INVALID
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

// ── Models ────────────────────────────────────────────────────────────────────

model User {
  id           String      @id @default(dbgenerated("gen_random_uuid()"))
  name         String
  email        String      @unique
  passwordHash String      @map("password_hash")
  role         UserRole    @default(ATTENDEE)
  status       UserStatus  @default(ACTIVE)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  deletedAt    DateTime?   @map("deleted_at")

  events                 Event[]
  staffAssignments       EventStaffAssignment[]
  payments               Payment[]
  auditLogs              AuditLog[]
  checkins               CheckIn[]

  @@map("users")
}

model Event {
  id          String      @id @default(dbgenerated("gen_random_uuid()"))
  title       String
  description String?
  venue       String?
  startTime   DateTime    @map("start_time")
  endTime     DateTime    @map("end_time")
  status      EventStatus @default(DRAFT)
  ownerId     String      @map("owner_id")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  deletedAt   DateTime?   @map("deleted_at")

  owner              User                   @relation(fields: [ownerId], references: [id])
  staffAssignments   EventStaffAssignment[]
  ticketCodes        TicketCode[]
  registrations      Registration[]
  checkins           CheckIn[]
  payments           Payment[]
  invoices           Invoice[]

  @@index([ownerId])
  @@index([status])
  @@map("events")
}

model EventStaffAssignment {
  id              String   @id @default(dbgenerated("gen_random_uuid()"))
  eventId         String   @map("event_id")
  userId          String   @map("user_id")
  permissionScope String?  @map("permission_scope")
  active          Boolean  @default(true)
  assignedAt      DateTime @default(now()) @map("assigned_at")

  event Event @relation(fields: [eventId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
  @@map("event_staff_assignments")
}

model TicketCode {
  id            String           @id @default(dbgenerated("gen_random_uuid()"))
  eventId       String           @map("event_id")
  code          String
  status        TicketCodeStatus @default(UNUSED)
  usedAt        DateTime?        @map("used_at")
  attendeeEmail String?          @map("attendee_email")
  attendeeName  String?          @map("attendee_name")
  createdAt     DateTime         @default(now()) @map("created_at")

  event        Event          @relation(fields: [eventId], references: [id])
  registration Registration?

  @@unique([eventId, code])
  @@index([eventId])
  @@index([code])
  @@map("ticket_codes")
}

model Registration {
  id             String             @id @default(dbgenerated("gen_random_uuid()"))
  eventId        String             @map("event_id")
  ticketCodeId   String             @unique @map("ticket_code_id")
  attendeeEmail  String             @map("attendee_email")
  attendeeName   String             @map("attendee_name")
  qrIssued       Boolean            @default(false) @map("qr_issued")
  qrIssuedAt     DateTime?          @map("qr_issued_at")
  status         RegistrationStatus @default(PENDING)
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  event      Event      @relation(fields: [eventId], references: [id])
  ticketCode TicketCode @relation(fields: [ticketCodeId], references: [id])
  qrToken    QrToken?
  checkins   CheckIn[]

  @@unique([eventId, ticketCodeId])
  @@index([eventId])
  @@index([attendeeEmail])
  @@map("registrations")
}

model QrToken {
  id             String    @id @default(dbgenerated("gen_random_uuid()"))
  registrationId String    @unique @map("registration_id")
  tokenHash      String    @unique @map("token_hash")
  issuedAt       DateTime  @default(now()) @map("issued_at")
  expiresAt      DateTime  @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  scanCount      Int       @default(0) @map("scan_count")

  registration Registration @relation(fields: [registrationId], references: [id])

  @@index([tokenHash])
  @@map("qr_tokens")
}

model CheckIn {
  id             String        @id @default(dbgenerated("gen_random_uuid()"))
  eventId        String        @map("event_id")
  registrationId String        @map("registration_id")
  staffId        String        @map("staff_id")
  scannedAt      DateTime      @default(now()) @map("scanned_at")
  result         CheckInResult
  deviceInfo     String?       @map("device_info")
  ipAddress      String?       @map("ip_address")

  event        Event        @relation(fields: [eventId], references: [id])
  registration Registration @relation(fields: [registrationId], references: [id])
  staff        User         @relation(fields: [staffId], references: [id])

  @@unique([eventId, registrationId])
  @@index([eventId])
  @@index([registrationId])
  @@map("check_ins")
}

model Payment {
  id                 String        @id @default(dbgenerated("gen_random_uuid()"))
  eventId            String        @map("event_id")
  userId             String        @map("user_id")
  paystackReference  String        @unique @map("paystack_reference")
  amount             Int
  currency           String        @default("NGN")
  status             PaymentStatus @default(PENDING)
  createdAt          DateTime      @default(now()) @map("created_at")
  paidAt             DateTime?     @map("paid_at")

  event   Event    @relation(fields: [eventId], references: [id])
  user    User     @relation(fields: [userId], references: [id])
  invoice Invoice?

  @@index([eventId])
  @@index([userId])
  @@index([paystackReference])
  @@map("payments")
}

model Invoice {
  id            String        @id @default(dbgenerated("gen_random_uuid()"))
  eventId       String        @map("event_id")
  paymentId     String        @unique @map("payment_id")
  invoiceNumber String        @unique @map("invoice_number")
  amount        Int
  issueDate     DateTime      @default(now()) @map("issue_date")
  dueDate       DateTime      @map("due_date")
  status        InvoiceStatus @default(PENDING)

  event   Event   @relation(fields: [eventId], references: [id])
  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([eventId])
  @@map("invoices")
}

model Notification {
  id          String             @id @default(dbgenerated("gen_random_uuid()"))
  recipient   String
  channel     String
  template    String
  status      NotificationStatus @default(PENDING)
  sentAt      DateTime?          @map("sent_at")
  readAt      DateTime?          @map("read_at")
  createdAt   DateTime           @default(now()) @map("created_at")

  @@index([recipient])
  @@map("notifications")
}

model AuditLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()"))
  actorId       String   @map("actor_id")
  action        String
  entity        String
  entityId      String   @map("entity_id")
  beforeSnapshot Json?   @map("before_snapshot")
  afterSnapshot  Json?   @map("after_snapshot")
  createdAt     DateTime @default(now()) @map("created_at")

  actor User @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([entity, entityId])
  @@map("audit_logs")
}
