<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <style>
    body { font-family: Arial, sans-serif; color: #333; line-height: 1.6; }
    .container { max-width: 600px; margin: 0 auto; padding: 20px; }
    .header { background: #4F46E5; color: white; padding: 20px; border-radius: 8px 8px 0 0; }
    .body { padding: 20px; background: #f9fafb; }
    .stats { display: flex; gap: 20px; margin: 20px 0; }
    .stat { flex: 1; text-align: center; padding: 15px; border-radius: 8px; }
    .stat-success { background: #d1fae5; color: #065f46; }
    .stat-error { background: #fee2e2; color: #991b1b; }
    .stat-total { background: #e0e7ff; color: #3730a3; }
    .stat-value { font-size: 24px; font-weight: bold; }
    .stat-label { font-size: 12px; text-transform: uppercase; }
    .errors { margin-top: 20px; }
    .error-item { padding: 8px; border-bottom: 1px solid #e5e7eb; font-size: 13px; }
    .footer { margin-top: 20px; font-size: 12px; color: #6b7280; text-align: center; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h2>Import Complete</h2>
      <p><%= eventTitle %></p>
    </div>
    <div class="body">
      <p>Your attendee import has finished processing.</p>
      <div class="stats">
        <div class="stat stat-total">
          <div class="stat-value"><%= totalRows %></div>
          <div class="stat-label">Total Rows</div>
        </div>
        <div class="stat stat-success">
          <div class="stat-value"><%= successRows %></div>
          <div class="stat-label">Imported</div>
        </div>
        <div class="stat stat-error">
          <div class="stat-value"><%= failedRows %></div>
          <div class="stat-label">Errors</div>
        </div>
      </div>
      <% if (errors && errors.length > 0) { %>
      <div class="errors">
        <h4>Error Details</h4>
        <% for (const err of errors) { %>
        <div class="error-item">
          <strong>Row <%= err.row %>:</strong> <%= err.error %>
          <% if (err.email) { %>(<%= err.email %>)<% } %>
        </div>
        <% } %>
      </div>
      <% } %>
    </div>
    <div class="footer">
      <p>QPass - Event Attendance & Ticketing Platform</p>
    </div>
  </div>
</body>
</html>
