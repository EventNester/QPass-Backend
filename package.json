{
  "name": "qpass-backend",
  "version": "1.0.0",
  "description": "QR Code-Based Event Attendance & Ticket Verification System",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "generate": "prisma generate --schema=./src/database/schema.prisma",
    "migrate": "prisma migrate dev --schema=./src/database/schema.prisma",
    "migrate:prod": "prisma migrate deploy --schema=./src/database/schema.prisma",
    "migrate:reset": "prisma migrate reset --schema=./src/database/schema.prisma",
    "seed": "node src/database/seed.js",
    "studio": "prisma studio --schema=./src/database/schema.prisma",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "docs": "swagger-jsdoc -d docs/swagger-definition.json -o docs/swagger.yaml \"./src/routes/*.js\" \"./src/modules/*/*.routes.js\"",
    "prepare": "node -e \"const fs=require('fs');if(fs.existsSync('./src/database/schema.prisma'))require('child_process').execSync('prisma generate --schema=./src/database/schema.prisma',{stdio:'inherit'});\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EventNester/QPass-Backend.git"
  },
  "keywords": [
    "event",
    "attendance",
    "qr-code",
    "ticketing",
    "verification"
  ],
  "author": "QPass Team",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/EventNester/QPass-Backend/issues"
  },
  "homepage": "https://github.com/EventNester/QPass-Backend#readme",
  "overrides": {
    "glob": "13.0.6",
    "yaml": "2.9.0",
    "swagger-jsdoc": {
      "yaml": "2.0.0-1"
    }
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "axios": "^1.8.4",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@prisma/config": "^6.2.0",
    "eslint": "^9.17.0",
    "nodemon": "^3.1.9",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.9.0",
    "supertest": "^7.0.0",
    "vitest": "^4.1.10"
  }
}
